// Cloudflare Workers config. The Worker (worker/index.js) serves this repo's static files and the Room Durable Object
// (SQLite-backed, WebSocket Hibernation). No data and no secrets in this file.
{
  "name": "sim",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // the Worker goes first so /m/<code>, /c/<code> and /ws/<code> work; it hands everything else to ASSETS
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "preview_urls": false,
  "workers_dev": false,
  "keep_vars": true,
  "routes": [{ "pattern": "sim.anantf.com", "custom_domain": true }]
}
