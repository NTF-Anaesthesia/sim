{
  "themeSchema": 1,
  "name": "Generic light",
  "background": "#f3f1ea",
  "font": {
    "family": "ui-monospace, Menlo, Consolas, monospace",
    "numericWeight": 800,
    "labelWeight": 600,
    "numericScale": 0.9,
    "labelScale": 1.1
  },
  "colors": {
    "ecg": "#0b6b1e",
    "spo2": "#0b5cad",
    "etco2": "#8a6100",
    "abp": "#b3261e",
    "abp2": "#b25a1e",
    "cvp": "#1e4fb3",
    "nibp": "#222222",
    "rr": "#8a6100",
    "temp": "#222222",
    "hr": "#0b6b1e",
    "alarmHigh": "#d32f2f",
    "alarmMed": "#f2b300",
    "alarmLow": "#1e88e5",
    "text": "#444444",
    "grid": "#d9d4c3",
    "flashText": "#ffffff"
  },
  "layout": {
    "grid": {
      "columns": 12,
      "rows": 12,
      "gap": 8
    },
    "cells": [
      {
        "module": "ecg",
        "part": "wave",
        "x": 4,
        "y": 1,
        "w": 8,
        "h": 3,
        "stack": "waves"
      },
      {
        "module": "spo2",
        "part": "wave",
        "x": 4,
        "y": 4,
        "w": 8,
        "h": 2,
        "stack": "waves"
      },
      {
        "module": "abp",
        "part": "wave",
        "x": 4,
        "y": 6,
        "w": 8,
        "h": 2,
        "stack": "waves"
      },
      {
        "module": "abp2",
        "part": "wave",
        "x": 4,
        "y": 6,
        "w": 8,
        "h": 2,
        "stack": "waves"
      },
      {
        "module": "cvp",
        "part": "wave",
        "x": 4,
        "y": 6,
        "w": 8,
        "h": 2,
        "stack": "waves"
      },
      {
        "module": "etco2",
        "part": "wave",
        "x": 4,
        "y": 8,
        "w": 8,
        "h": 1.5,
        "stack": "waves"
      },
      {
        "module": "nibp",
        "part": "numeric",
        "x": 4,
        "y": 9.5,
        "w": 8,
        "h": 2.5
      },
      {
        "module": "ecg",
        "part": "numeric",
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 2.5,
        "stack": "numbers"
      },
      {
        "module": "spo2",
        "part": "numeric",
        "x": 0,
        "y": 3.5,
        "w": 4,
        "h": 2.5,
        "stack": "numbers"
      },
      {
        "module": "abp",
        "part": "numeric",
        "x": 0,
        "y": 6,
        "w": 4,
        "h": 2.5,
        "stack": "numbers"
      },
      {
        "module": "abp2",
        "part": "numeric",
        "x": 0,
        "y": 6,
        "w": 4,
        "h": 2.5,
        "stack": "numbers"
      },
      {
        "module": "cvp",
        "part": "numeric",
        "x": 0,
        "y": 6,
        "w": 4,
        "h": 2.5,
        "stack": "numbers"
      },
      {
        "module": "etco2",
        "part": "numeric",
        "x": 0,
        "y": 8.5,
        "w": 4,
        "h": 1.5,
        "stack": "numbers"
      },
      {
        "module": "etco2",
        "part": "numeric2",
        "x": 0,
        "y": 10,
        "w": 4,
        "h": 1,
        "stack": "numbers"
      },
      {
        "module": "rr",
        "part": "numeric",
        "x": 0,
        "y": 10,
        "w": 4,
        "h": 1,
        "stack": "numbers"
      },
      {
        "module": "temp",
        "part": "numeric",
        "x": 0,
        "y": 11,
        "w": 4,
        "h": 1,
        "stack": "numbers"
      }
    ],
    "alarmBar": {
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 1
    }
  },
  "waves": {
    "speedMmPerSec": 25,
    "pxPerMm": 3,
    "lineWidth": 2.5,
    "sweepGapPx": 18,
    "fill": false,
    "grid": true,
    "ecg": {
      "speed": 25,
      "gain": 1
    },
    "spo2": {
      "speed": 25,
      "gain": 1
    },
    "etco2": {
      "speed": 12.5,
      "gain": 1
    },
    "abp": {
      "speed": 25,
      "gain": 1
    },
    "abp2": {
      "speed": 25,
      "gain": 1
    },
    "cvp": {
      "speed": 25,
      "gain": 1
    }
  },
  "audio": {
    "alarm": {
      "volume": 1
    },
    "qrs": {
      "volume": 0.5
    },
    "spo2": {
      "volume": 0.5
    }
  },
  "numerics": {
    "showLimits": true,
    "limitsPosition": "below",
    "decimals": {
      "temp": 1
    },
    "fontScale": 1
  },
  "nibp": {
    "inflateMs": 4000,
    "measureMs": 6000
  },
  "labels": {
    "ecg": "Pulse",
    "spo2": "Sat",
    "etco2": "CO2",
    "rr": "Resp",
    "nibp": "Cuff",
    "temp": "Temp",
    "abp": "Art",
    "abp2": "Art 2",
    "cvp": "CVP",
    "units": {
      "hr": "/min",
      "spo2": "%",
      "etco2": "mmHg",
      "rr": "/min",
      "temp": "°C",
      "nibp": "mmHg",
      "abp": "mmHg",
      "abp2": "mmHg",
      "cvp": "mmHg"
    },
    "wave": {
      "ecg": "ECG",
      "spo2": "SpO2",
      "etco2": "CO2",
      "abp": "ART",
      "abp2": "ART2",
      "cvp": "CVP"
    },
    "off": {
      "ecg": "LEADS OFF",
      "spo2": "PROBE OFF",
      "etco2": "CO2 LINE OFF",
      "abp": "ART LINE OFF",
      "abp2": "ART2 LINE OFF",
      "cvp": "CVP LINE OFF"
    }
  },
  "alarmStyle": {
    "barPosition": "top-center",
    "flashHz": 1.5,
    "limitStyle": "bold",
    "tones": "soft",
    "toneHz": {
      "high": 880,
      "medium": 700,
      "low": 560
    }
  }
}
